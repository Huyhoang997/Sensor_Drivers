# Add inputs and outputs from these tool invocations to the build variables 

# All Target
all: main-build

# Main-build Target
main-build: xg26_tft_spi_Lib.axf

# Tool invocations
xg26_tft_spi_Lib.axf: $(OBJS) $(USER_OBJS) makefile objects.mk $(OPTIONAL_TOOL_DEPS)
	@echo 'Building target: $@'
	@echo 'Invoking: GNU ARM C++ Linker'
	arm-none-eabi-g++ '@xg26_tft_spi_Lib.axf.rsp' -o xg26_tft_spi_Lib.axf 
	@echo 'Finished building target: $@'
	@echo ' '

	@echo 'Building out file: xg26_tft_spi_Lib.out'
	arm-none-eabi-objcopy "xg26_tft_spi_Lib.axf" "xg26_tft_spi_Lib.out"
	@echo ' '

	@echo 'Building hex file: xg26_tft_spi_Lib.hex'
	arm-none-eabi-objcopy -O ihex "xg26_tft_spi_Lib.axf" "xg26_tft_spi_Lib.hex"
	@echo ' '

	@echo 'Building bin file: xg26_tft_spi_Lib.bin'
	arm-none-eabi-objcopy -O binary "xg26_tft_spi_Lib.axf" "xg26_tft_spi_Lib.bin"
	@echo ' '

	@echo 'Building s37 file: xg26_tft_spi_Lib.s37'
	arm-none-eabi-objcopy -O srec "xg26_tft_spi_Lib.axf" "xg26_tft_spi_Lib.s37"
	@echo ' '

	@echo 'Running size tool'
	arm-none-eabi-size "xg26_tft_spi_Lib.axf" -A
	@echo ' '

# Other Targets
clean:
	-@$(foreach FILE, $(CC_DEPS), $(shell $(RM) $(FILE)) )
	-@$(foreach FILE, $(C++_DEPS), $(shell $(RM) $(FILE)) )
	-@$(foreach FILE, $(CCM_DEPS), $(shell $(RM) $(FILE)) )
	-@$(foreach FILE, $(EXECUTABLES), $(shell $(RM) $(FILE)) )
	-@$(foreach FILE, $(OBJS), $(shell $(RM) $(FILE)) )
	-@$(foreach FILE, $(C_UPPER_DEPS), $(shell $(RM) $(FILE)) )
	-@$(foreach FILE, $(CXX_DEPS), $(shell $(RM) $(FILE)) )
	-@$(foreach FILE, $(CXXM_DEPS), $(shell $(RM) $(FILE)) )
	-@$(foreach FILE, $(C++M_DEPS), $(shell $(RM) $(FILE)) )
	-@$(foreach FILE, $(C_DEPS), $(shell $(RM) $(FILE)) )
	-@$(foreach FILE, $(CPP_DEPS), $(shell $(RM) $(FILE)) )
	-$(RM) xg26_tft_spi_Lib.axf
	-@echo ' '

